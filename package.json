{
  "name": "mystmd-client",
  "version": "0.0.1",
  "description": "Start mystmd, read its content server, and parse MyST with mystmd's own settings",
  "type": "module",
  "exports": {
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./start": {
      "types": "./dist/start.d.ts",
      "default": "./dist/start.js"
    },
    "./content-server": {
      "types": "./dist/content-server.d.ts",
      "default": "./dist/content-server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "test:mystmd": "TEST_MYSTMD=1 npm test",
    "prepare": "npm run build",
    "docs": "cd docs && myst build --html",
    "docs:live": "cd docs && myst start"
  },
  "dependencies": {
    "myst-common": "^1.10.1",
    "myst-directives": "^1.7.4",
    "myst-ext-button": "^0.0.2",
    "myst-ext-card": "^1.0.9",
    "myst-ext-exercise": "^1.0.10",
    "myst-ext-grid": "^1.1.1",
    "myst-ext-proof": "^1.0.13",
    "myst-ext-tabs": "^1.0.10",
    "myst-parser": "^1.7.4",
    "myst-roles": "^1.7.4",
    "myst-transforms": "^1.3.51",
    "unified": "^10.1.2",
    "unist-util-visit": "^4.1.2",
    "vfile": "^5.3.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "mystmd": "^1.11.0",
    "typescript": "^7.0.2"
  },
  "license": "CC0-1.0",
  "keywords": [
    "myst",
    "mystmd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choldgraf/mystmd-client.git"
  }
}
